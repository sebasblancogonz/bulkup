---
// EN-only SEO article page: prose + waitlist CTA. Not localized (US-targeted).
import BaseLayout from './BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import Footer from '../components/sections/Footer.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { articleLd } from '../lib/seo';

interface Props { title: string; description: string; path: string; h1: string; eyebrow?: string }
const { title, description, path, h1, eyebrow } = Astro.props;
---
<BaseLayout locale="en" path={path} title={title} description={description} enOnly>
  <JsonLd slot="head" data={articleLd(title, description, path)} />
  <Header locale="en" />
  <main class="relative">
    <article class="mx-auto w-full max-w-[720px] px-6 pt-16 pb-20 sm:pt-20">
      {eyebrow && (
        <p class="font-[family-name:var(--font-mono)] text-sm tracking-widest uppercase text-[var(--color-accent)]">{eyebrow}</p>
      )}
      <h1 class="h2 mt-3 text-balance text-[var(--color-fg)]">{h1}</h1>
      <div class="article-prose mt-8">
        <slot />
      </div>
    </article>
  </main>
  <FinalCta locale="en" />
  <Footer locale="en" />
</BaseLayout>

<style is:global>
  .article-prose { color: var(--color-muted); font-size: 17px; line-height: 1.7; }
  .article-prose h2 {
    font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.01em;
    color: var(--color-fg); font-weight: 700; font-size: 1.45rem; margin: 2.2em 0 0.6em;
  }
  .article-prose p { margin: 1em 0; }
  .article-prose ul { margin: 1em 0; padding-left: 1.2em; list-style: disc; }
  .article-prose li { margin: 0.4em 0; }
  .article-prose strong { color: var(--color-fg); font-weight: 600; }
  .article-prose a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
  .article-prose table { width: 100%; margin: 1.4em 0; border-collapse: collapse; font-size: 15px; }
  .article-prose th, .article-prose td { border: 1px solid var(--color-line); padding: 10px 12px; text-align: left; vertical-align: top; }
  .article-prose th { color: var(--color-fg); font-weight: 600; background: rgba(255,255,255,0.03); }
</style>
